{
  "name": "aws-cdk-private-lambda-document-intake",
  "version": "1.0.0",
  "description": "Document intake on AWS with Lambda functions that have no route to the internet. CDK, TypeScript.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "synth": "cdk synth --quiet",
    "check": "npm run build && npm test && npm run synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1151.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/lib-dynamodb": "^3.1151.0",
    "@aws-sdk/s3-presigned-post": "^3.1151.0",
    "aws-cdk-lib": "^2.273.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "aws-cdk": "^2.1145.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
